# ==============================================================================
# Rewind — Environment Configuration Example
# ==============================================================================
# Copy this file to .env.local to configure your AI model provider, Firebase, and limits.
# .env.local is ignored by git and will never be committed or exposed to the client.

# ------------------------------------------------------------------------------
# 1. AI Model Provider (NVIDIA API / Nebius Token Factory)
# ------------------------------------------------------------------------------
AI_PROVIDER="nvidia"
NVIDIA_API_KEY=""
NVIDIA_BASE_URL="https://integrate.api.nvidia.com/v1"
# Supported models: nvidia/nemotron-3.5-lightning-30b-a3b, nvidia/nemotron-3-super-120b-a12b
NVIDIA_MODEL="nvidia/nemotron-3.5-lightning-30b-a3b"

# Alternative: Nebius Token Factory
# AI_PROVIDER="nebius"
# NEBIUS_API_KEY=""
# NEBIUS_BASE_URL="https://api.tokenfactory.nebius.com/v1"
# NEBIUS_MODEL="nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B"

# ------------------------------------------------------------------------------
# 2. Firebase Cloud Firestore (Optional - Local Filesystem Fallback Enabled by Default)
# ------------------------------------------------------------------------------
# Set these to enable cloud persistence of projects, audit history, and RAG document states.
# If left blank, Rewind automatically and safely falls back to local storage in .rewind_store/.
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
# For multi-line private key in .env, either escape newlines with \n or provide JSON path
FIREBASE_PRIVATE_KEY=""
# Or path to service account JSON:
# GOOGLE_APPLICATION_CREDENTIALS=""

# ------------------------------------------------------------------------------
# 3. RAG Semantic Knowledge Base & Vector Embeddings
# ------------------------------------------------------------------------------
# When false, uses fast, zero-dependency deterministic local tokenized projection embeddings.
# When true, queries NVIDIA/OpenAI compatible /embeddings endpoint.
ENABLE_REMOTE_EMBEDDINGS="false"
NVIDIA_EMBEDDING_MODEL="nvidia/nv-embed-v1"

# ------------------------------------------------------------------------------
# 4. Centralized Resource Limits & Quotas (Hardened Defaults)
# ------------------------------------------------------------------------------
# Maximum individual code or text file upload size (default: 1 MB = 1048576)
REWIND_MAX_FILE_SIZE_BYTES="1048576"

# Maximum PDF or document upload size (default: 10 MB = 10485760)
REWIND_MAX_DOCUMENT_SIZE_BYTES="10485760"

# Maximum files permitted per single upload batch (default: 10)
REWIND_MAX_FILES_PER_UPLOAD="10"

# Maximum aggregate batch upload size (default: 25 MB = 26214400)
REWIND_MAX_TOTAL_UPLOAD_SIZE_BYTES="26214400"

# Maximum disk storage per project workspace (default: 100 MB = 104857600)
REWIND_MAX_PROJECT_STORAGE_BYTES="104857600"

# Maximum snapshots retained per project before rotation (default: 50)
REWIND_MAX_SNAPSHOTS_PER_PROJECT="50"

# Maximum workspace files scanned during diagnostics / explorer (default: 500)
REWIND_MAX_WORKSPACE_FILES="500"

# Maximum files included in AI proposal context window (default: 20)
REWIND_MAX_AI_CONTEXT_FILES="20"

# Maximum bytes sent to AI model context window (default: 200 KB = 204800)
REWIND_MAX_AI_CONTEXT_BYTES="204800"
