# ==============================================================================
# Rewind — Environment Configuration Example
# ==============================================================================
# Copy this file to .env.local to configure your environment.
# .env.local is ignored by git and will never be committed or exposed to the client.

# ------------------------------------------------------------------------------
# 1. Session Security & Server Configuration
# ------------------------------------------------------------------------------
# High-entropy secret for signing session cookies and HMAC tokens (min 32 characters).
# Required in staging and production (either AUTH_SESSION_SECRET or SESSION_SECRET).
AUTH_SESSION_SECRET="your-high-entropy-session-secret-here-at-least-32-chars"
# SESSION_SECRET="your-high-entropy-session-secret-here-at-least-32-chars"

# Enforce Firebase Authentication in all environments (fails closed if unconfigured or unreachable).
# Set to "true" when running with Firebase Authentication (either AUTH_REQUIRE_FIREBASE or REQUIRE_FIREBASE).
AUTH_REQUIRE_FIREBASE="false"
# REQUIRE_FIREBASE="true"

# Enforce Cloud Firestore and Cloud Storage for durable serverless persistence:
# In production (NODE_ENV=production), cloud storage is required by default.
# Set REQUIRE_CLOUD_STORAGE="true" to mandate cloud storage in staging/preview.
REQUIRE_CLOUD_STORAGE="false"
# REWIND_STORAGE_PROVIDER="cloud"

# Local authentication/storage safety guard for production:
# When NODE_ENV=production, local filesystem auth and storage are blocked by default.
# Only set to "true" if running a private single-tenant local deployment without cloud storage.
REWIND_ALLOW_LOCAL_AUTH_IN_PROD="false"
REWIND_ALLOW_LOCAL_STORAGE_IN_PROD="false"

# Server network binding (default: 127.0.0.1 for private staging/development)
REWIND_BIND_HOST="127.0.0.1"

# Development authentication overrides (leave unset or "false" in staging/production)
# REWIND_STRICT_AUTH="false"
# REWIND_DISABLE_DEV_AUTH="false"

# ------------------------------------------------------------------------------
# 2. Firebase Client Authentication (Web API)
# ------------------------------------------------------------------------------
# Firebase Web API Key (from Firebase Console -> Project Settings -> General -> Web API Key).
# Required for email/password authentication (Identity Toolkit REST API).
# Either NEXT_PUBLIC_FIREBASE_API_KEY or FIREBASE_API_KEY can be provided.
NEXT_PUBLIC_FIREBASE_API_KEY=""
FIREBASE_API_KEY=""

# ------------------------------------------------------------------------------
# 3. Firebase Admin SDK & Cloud Firestore (Server-Side)
# ------------------------------------------------------------------------------
# Firebase Project ID (from Firebase Console -> Project Settings -> General -> Project ID).
# Required for Firebase Admin SDK and Cloud Firestore.
FIREBASE_PROJECT_ID=""

# Service Account Client Email (from Firebase Console -> Project Settings -> Service Accounts).
FIREBASE_CLIENT_EMAIL=""

# Service Account Private Key (from downloaded Service Account JSON).
# Paste the full private key including -----BEGIN PRIVATE KEY----- and -----END PRIVATE KEY-----.
# In .env files, newlines can be escaped as \n.
FIREBASE_PRIVATE_KEY=""

# Firebase Cloud Storage bucket name (OPTIONAL):
# Only required if using Google Cloud Storage on the Firebase Blaze billing plan.
# When omitted (recommended for Firebase Spark free tier), Rewind automatically uses
# the Firestore-backed file storage adapter with bounded 256 KB chunking, requiring
# zero Cloud Storage buckets, zero Blaze billing upgrades, and zero credit card fees.
# e.g. "your-project-id.firebasestorage.app" or "your-project-id.appspot.com"
FIREBASE_STORAGE_BUCKET=""

# Optional Alternative to FIREBASE_CLIENT_EMAIL & FIREBASE_PRIVATE_KEY:
# Absolute or relative path to your Google Service Account JSON file on the server.
# GOOGLE_APPLICATION_CREDENTIALS="/path/to/service-account.json"

# ------------------------------------------------------------------------------
# 4. Distributed Rate Limiting (Upstash Redis / Vercel KV)
# ------------------------------------------------------------------------------
# Serverless REST endpoints for distributed rate limiting across Lambda instances.
# When provided, rate limiting operates globally across instances with sliding windows.
# When absent, falls back safely to per-instance in-memory rate limiting unless REQUIRE_DISTRIBUTED_RATE_LIMIT="true".
# Mandate distributed rate limiting in production (fails closed with 503 if Redis is unreachable or unconfigured):
REQUIRE_DISTRIBUTED_RATE_LIMIT="false"
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Alternative Vercel KV REST configuration (if using Vercel Marketplace KV integration):
# KV_REST_API_URL=""
# KV_REST_API_TOKEN=""

# ------------------------------------------------------------------------------
# 5. AI Model Provider (NVIDIA API / Nebius Token Factory / Disabled)
# ------------------------------------------------------------------------------
# Provider selection: "disabled" (recommended for safe preview deployment without AI key),
# "nvidia", or "nebius".
AI_PROVIDER="disabled"
NVIDIA_API_KEY=""
NVIDIA_BASE_URL="https://integrate.api.nvidia.com/v1"
NVIDIA_MODEL="nvidia/nemotron-3.5-lightning-30b-a3b"

# Alternative: Nebius Token Factory (keep inactive unless explicitly authorized)
# AI_PROVIDER="nebius"
# NEBIUS_API_KEY=""
# NEBIUS_BASE_URL="https://api.tokenfactory.nebius.com/v1"
# NEBIUS_MODEL="nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B"

# ------------------------------------------------------------------------------
# 5. RAG Semantic Knowledge Base & Vector Embeddings
# ------------------------------------------------------------------------------
# When false, uses fast zero-dependency deterministic local tokenized projection embeddings.
# When true, queries NVIDIA/OpenAI compatible /embeddings endpoint.
ENABLE_REMOTE_EMBEDDINGS="false"
NVIDIA_EMBEDDING_MODEL="nvidia/nv-embed-v1"

# ------------------------------------------------------------------------------
# 6. Centralized Resource Limits & Quotas (Hardened Defaults)
# ------------------------------------------------------------------------------
# Maximum individual code or text file upload size (default: 1 MB = 1048576)
REWIND_MAX_FILE_SIZE_BYTES="1048576"

# Maximum PDF or document upload size (default: 10 MB = 10485760)
REWIND_MAX_DOCUMENT_SIZE_BYTES="10485760"

# Maximum files permitted per single upload batch (default: 10)
REWIND_MAX_FILES_PER_UPLOAD="10"

# Maximum aggregate batch upload size (default: 25 MB = 26214400)
REWIND_MAX_TOTAL_UPLOAD_SIZE_BYTES="26214400"

# Maximum disk storage per project workspace (default: 100 MB = 104857600)
REWIND_MAX_PROJECT_STORAGE_BYTES="104857600"

# Maximum snapshots retained per project before rotation (default: 50)
REWIND_MAX_SNAPSHOTS_PER_PROJECT="50"

# Maximum workspace files scanned during diagnostics / explorer (default: 500)
REWIND_MAX_WORKSPACE_FILES="500"

# Maximum files included in AI proposal context window (default: 20)
REWIND_MAX_AI_CONTEXT_FILES="20"

# Maximum bytes sent to AI model context window (default: 200 KB = 204800)
REWIND_MAX_AI_CONTEXT_BYTES="204800"
